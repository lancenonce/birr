# Copy to server/.env (gitignored). Get these from https://dev.primuslabs.xyz/myDevelopment/myProjects
APP_ID=
# Shown only once when the project is created. Never put this in the frontend.
APP_SECRET=
# Attestation template for the NBE USD rate (Developer Hub -> your custom template)
TEMPLATE_ID=
# Comma-separated list of frontend origins allowed to call /sign ("*" = any)
ALLOWED_ORIGINS=http://localhost:3000
PORT=9000
