# Copy to contracts/.env (gitignored). Foundry loads it automatically.
PRIVATE_KEY=
SEPOLIA_RPC_URL=
UNICHAIN_SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=

# --- Official rate (zkTLS) ---------------------------------------------------
# 1) forge script script/DeployPrimusVerifier.s.sol --rpc-url sepolia --broadcast --verify
#    then paste the printed proxy address here.
PRIMUS_VERIFIER=
# Optional override; defaults to Primus production attestor 0x5Ed3176045F68617B0958a61ac1868875C98C14d
# PRIMUS_ATTESTOR=

# 2) forge script script/DeployOfficialRate.s.sol --rpc-url sepolia --broadcast --verify
# Optional: USDC base units to move from the deployer into ETB as the payout reserve (6 decimals).
RESERVE_USDC=0
# Optional overrides (defaults shown)
# SPEC_FILE=script/config/nbe-spec.json
# MAX_ATTESTATION_AGE=3600
# MIN_RATE=10000000000000000000
# MAX_RATE=10000000000000000000000
# USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# POOL_MANAGER=

# Filled in after deploying; used by SubmitRate / ConfigureOracleSpec / MintETB / TestBridge
ORACLE_ADDRESS=
ETB_ADDRESS=
# Path to a saved attestation JSON (SubmitRate)
ATTESTATION_FILE=
