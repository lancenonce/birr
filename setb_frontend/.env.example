# Copy to setb_frontend/.env (gitignored). Restart `npm start` after editing.

# Primus Developer Hub (https://dev.primuslabs.xyz) — appId only; the appSecret lives in server/.env
REACT_APP_PRIMUS_APP_ID=
REACT_APP_PRIMUS_TEMPLATE_ID=
# Signing server from server/ (npm start there)
REACT_APP_SIGNER_URL=http://localhost:9000

# From contracts/script/DeployOfficialRate.s.sol output
REACT_APP_ORACLE_ADDRESS=
REACT_APP_ETB_ADDRESS=

# Optional overrides
# REACT_APP_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# REACT_APP_USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# REACT_APP_ETB_UNICHAIN_ADDRESS=0xdD3324AB2e26268E15c792Cb8c1f0eD8bA9A4C76
